"terms.title" = "Terms of Use";
"terms.intro" = "Walkuno is an activity tracking app published by Orbelio. These terms explain its use and respect for its content. The privacy policy in Settings explains how data is handled.";
"terms.use.title" = "Using Walkuno";
"terms.use.body" = "You may use Walkuno for personal purposes on compatible devices without creating an account. The app is licensed under the Apple Standard License Agreement linked below. Follow applicable law and respect the rights of others.";
"terms.health.title" = "Activity and wellness";
"terms.health.body" = "Measurements and goals are wellness indicators whose accuracy depends on devices, sources and Health permissions. Walkuno provides no diagnosis or medical advice. Adapt your activity to your circumstances and seek professional advice when needed.";
"terms.purchases.title" = "Free and Pro features";
"terms.purchases.body" = "Features and offer prices are shown before purchase. Apple handles payments and refund requests. Subscriptions renew under the terms shown by Apple; manage or cancel them in your Apple account. Erasing local data or uninstalling Walkuno does not cancel a subscription. Restore purchases in Settings.";
"terms.brand.title" = "Respecting the brand and its creations";
"terms.brand.body" = "The Walkuno and Orbelio names, logos, illustrations, interface and code are protected by their owners’ applicable intellectual property rights. Without permission, you may not commercially exploit or redistribute them, or present a creation as official or affiliated with Orbelio. Uses permitted by law remain allowed. Apple and third-party trademarks belong to their respective owners.";
"terms.sharing.title" = "Your data and sharing";
"terms.sharing.body" = "You retain your rights to your activity data. You may share cards created by Walkuno for personal purposes while keeping the app attribution and without suggesting an official partnership. Check visible information and recipients before sharing.";
"terms.availability.title" = "Operation and changes";
"terms.availability.body" = "Some features require Health, a compatible device or Apple services. Availability may vary. Updates may change the app; applicable terms remain available in Settings. Statutory warranties and mandatory consumer rights continue to apply.";
"terms.rights.title" = "Questions and rights";
"terms.rights.body" = "To contact Orbelio, use the support link on the Walkuno App Store listing. These terms supplement Apple’s rules without limiting your legal rights, including warranties, remedies and data protection.";
"terms.apple" = "Apple Standard License Agreement";
"terms.editor" = "Orbelio · Terms dated November 5, 2026 · Version 1.0";
"privacy.sharing" = "You alone initiate card sharing. Visible information is sent to the app or recipient you choose under that service’s rules. Orbelio does not receive these shares.";
"privacy.storage" = "Preferences and goals remain on your devices until erased; any backup depends on your Apple settings. The widget cache is replaced as it refreshes and can be erased in Settings. Health services, backups and purchases managed by Apple are also subject to Apple settings and privacy policy. For questions, use the support link on the Walkuno App Store listing.";

